nextflow.enable.moduleBinaries = true

process {
    withName: 'SAMPLE_INPUT_PREP'{
         publishDir = [
            path: { "${params.outdir}/samples_converted2zarr" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]

    }


    withName: 'RUN_ULTRACK' {
        publishDir = [
            path: { "${params.outdir}/tracking/${meta.id}" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CELLPOSE_SAM_ZARR_MIF_TILED' {
        publishDir = [
            path: { "/scratch/${System.getenv('USER')}/cellpose_tiles_published/${meta.source_dataset_id}" },
            mode: 'link',
            overwrite: false
        ]
    }
}
