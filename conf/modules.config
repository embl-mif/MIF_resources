nextflow.enable.moduleBinaries = true

process {
    withName: 'RUN_ULTRACK' {
        clusterOptions = '--gres=gpu:3090:1'
        publishDir = [
            path: { "${params.outdir}/tracking/${meta.id}" },
            mode: 'copy',
            saveAs: { filename -> (filename.equals('versions.yml') || filename.endsWith('.zarr')) ? null : filename }
        ]
    }
}
